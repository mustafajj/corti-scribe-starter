# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# All four values are on your API client's page in Corti AI Studio (console.corti.app).

CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=

# Usually "base".
CORTI_TENANT_NAME=base

# "eu" or "us": the region you chose when you created the project.
CORTI_ENVIRONMENT=eu
